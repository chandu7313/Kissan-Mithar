datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum Role {
  FARMER
  EXPERT
  ADMIN
}

enum OrchardRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  EXPERT_ASSIGNED
  PLAN_READY
  COMPLETED
}

enum ConsultationStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ConsultationMode {
  VOICE
  VIDEO
  CHAT
}

enum NotificationType {
  ALERT
  SUCCESS
  CONSULTATION
  MARKET
  INFO
}

model Farmer {
  id           String   @id @default(uuid())
  firebaseUid  String   @unique
  phoneNumber  String   @unique
  name         String
  photoUrl     String?
  village      String?
  district     String?
  state        String?
  landAcres    Float?   @default(0.0)
  primaryCrop  String?
  languageCode String   @default("en")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orchardRequests OrchardRequest[]
  consultations   Consultation[]
  notifications   Notification[]
  devices         Device[]
  drafts          OfflineDraft[]

  @@map("farmers")
}

model Expert {
  id              String   @id @default(uuid())
  firebaseUid     String?  @unique
  name            String
  phoneNumber     String   @unique
  email           String?  @unique
  passwordHash    String?
  photoUrl        String?
  specialization  String
  experienceYears Int      @default(5)
  rating          Float    @default(4.8)
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignedOrchardRequests OrchardRequest[]
  consultations           Consultation[]
  advisories              CropAdvisory[]

  @@map("experts")
}

model Admin {
  id           String   @id @default(uuid())
  firebaseUid  String?  @unique
  name         String
  email        String   @unique
  passwordHash String?
  photoUrl     String?
  mobileNumber String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

model OrchardRequest {
  id           String               @id @default(uuid())
  farmerId     String
  expertId     String?
  status       OrchardRequestStatus @default(SUBMITTED)
  photos       Json                 // { front: string, left: string, right: string, center: string }
  gps          Json                 // { latitude: number, longitude: number, accuracy: number, village: string, district: string, state: string }
  landDetails  Json                 // { size: string, soilType: string, waterSources: string[], electricity: boolean, drip: boolean, existingCrops: string[] }
  notes        String?
  voiceNoteUrl String?
  submittedAt  DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  farmer Farmer         @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  expert Expert?        @relation(fields: [expertId], references: [id], onDelete: SetNull)
  report OrchardReport?

  @@index([farmerId])
  @@index([expertId])
  @@index([status])
  @@map("orchard_requests")
}

model OrchardReport {
  id                     String   @id @default(uuid())
  orchardRequestId       String   @unique
  pdfUrl                 String?
  summary                String
  recommendedVarieties   Json     // Array of { crop: string, variety: string, yieldPerAcre: string, plantingSeason: string }
  plantationLayout       Json     // { rowSpacingMeters: number, plantSpacingMeters: number, totalPlantsEstimate: number }
  waterRequirement       String
  soilTreatment          String
  fertilizerSchedule     String?
  pestControl            String
  estimatedBudget        Float
  projectedRoi           String?
  implementationTimeline String?
  governmentSchemes      String?
  maintenanceCalendar    String?
  generatedAt            DateTime @default(now())
  updatedAt              DateTime @updatedAt

  orchardRequest OrchardRequest @relation(fields: [orchardRequestId], references: [id], onDelete: Cascade)

  @@map("orchard_reports")
}

model Consultation {
  id           String             @id @default(uuid())
  farmerId     String
  expertId     String?
  mode         ConsultationMode   @default(VOICE)
  category     String
  scheduledAt  DateTime
  language     String             @default("English")
  status       ConsultationStatus @default(SCHEDULED)
  notes        String?
  mediaUrls    Json?              // string[]
  voiceNoteUrl String?
  prescription Json?              // { diagnosis: string, medicines: string[], followUpNotes: string }
  followUpDate DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  farmer Farmer  @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  expert Expert? @relation(fields: [expertId], references: [id], onDelete: SetNull)

  @@index([farmerId])
  @@index([expertId])
  @@index([status])
  @@map("consultations")
}

model Notification {
  id        String           @id @default(uuid())
  farmerId  String
  title     String
  body      String
  type      NotificationType @default(INFO)
  deepLink  String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([farmerId])
  @@index([isRead])
  @@map("notifications")
}

model Device {
  id         String   @id @default(uuid())
  farmerId   String
  fcmToken   String   @unique
  platform   String   @default("android")
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([farmerId])
  @@map("devices")
}

enum AuthAction {
  LOGIN
  LOGOUT
  TOKEN_REFRESH
  PASSWORD_RESET
}

model AuthAuditLog {
  id        String     @id @default(uuid())
  userId    String
  userType  Role       @default(EXPERT)
  userName  String?
  userEmail String?
  action    AuthAction
  ipAddress String?
  userAgent String?
  metadata  Json?
  timestamp DateTime   @default(now())

  @@index([userId])
  @@index([userType])
  @@index([action])
  @@index([timestamp])
  @@map("auth_audit_logs")
}

model EmailOtp {
  id        String   @id @default(uuid())
  email     String
  otp       String
  purpose   String   @default("LOGIN") // "LOGIN" | "RESET_PASSWORD"
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([purpose])
  @@map("email_otps")
}

model MandiPrice {
  id         String   @id @default(uuid())
  commodity  String
  variety    String?
  market     String
  district   String
  state      String
  minPrice   Float    // Price in Rs/Quintal
  maxPrice   Float
  modalPrice Float
  priceDate  DateTime @default(now())
  trend      String   @default("STABLE") // "UP" | "DOWN" | "STABLE"
  createdAt  DateTime @default(now())

  @@index([commodity])
  @@index([market])
  @@index([state])
  @@map("mandi_prices")
}

model CropAdvisory {
  id          String   @id @default(uuid())
  expertId    String?
  crop        String
  title       String
  description String
  alertLevel  String   @default("NORMAL") // "NORMAL" | "WARNING" | "CRITICAL"
  season      String   @default("KHARIF") // "KHARIF" | "RABI" | "ZAID" | "ALL_SEASON"
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  expert Expert? @relation(fields: [expertId], references: [id], onDelete: SetNull)

  @@index([crop])
  @@index([alertLevel])
  @@map("crop_advisories")
}

model OfflineDraft {
  id          String   @id @default(uuid())
  farmerId    String
  flowType    String   @default("ORCHARD_PLAN") // "ORCHARD_PLAN" | "CONSULTATION"
  draftData   Json
  isSynced    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([farmerId])
  @@index([flowType])
  @@map("offline_drafts")
}
