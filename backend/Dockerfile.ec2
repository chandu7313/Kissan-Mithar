# ==============================================================================
# Multi-Stage Dockerfile for Kissan Mithar Backend (AWS EC2 / Production Container)
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build stage (compile TypeScript & generate Prisma client)
# ------------------------------------------------------------------------------
FROM node:20-bookworm-slim AS builder

WORKDIR /app

# Install OpenSSL & certificates for Prisma engine compilation
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends openssl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Install dependencies (respecting package-lock.json)
COPY package.json package-lock.json* ./
COPY prisma ./prisma
RUN npm ci

# Copy application source code and TypeScript config
COPY tsconfig.json ./
COPY src ./src

# Build TypeScript to dist/
RUN npm run build

# Prune development dependencies to keep final image slim
RUN npm prune --omit=dev

# ------------------------------------------------------------------------------
# Stage 2: Production EC2 Runner Image (Node.js runtime)
# ------------------------------------------------------------------------------
FROM node:20-bookworm-slim AS runner

WORKDIR /app

# Install OpenSSL for Prisma and curl for container healthcheck
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends openssl ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

# Run as non-root user for security
RUN groupadd -r nodejs && useradd -r -g nodejs nodejs

# Copy production node_modules from builder
COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules

# Copy compiled JavaScript output
COPY --from=builder --chown=nodejs:nodejs /app/dist ./dist

# Copy package metadata and prisma schema/engines
COPY --from=builder --chown=nodejs:nodejs /app/package.json ./package.json
COPY --from=builder --chown=nodejs:nodejs /app/prisma ./prisma

# Create uploads directory with correct permissions
RUN mkdir -p uploads && chown -R nodejs:nodejs /app

USER nodejs

# Set production environment flag and port
ENV NODE_ENV=production
ENV PORT=4000

EXPOSE 4000

# Native container health check against the /health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:4000/health || exit 1

# Start the full HTTP server (with Socket.IO and CleanupService)
CMD [ "node", "dist/server.js" ]

