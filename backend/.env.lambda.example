# ==============================================================================
# KISSAN MITHAR — AWS LAMBDA ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# In AWS Lambda + SAM, these values are passed via samconfig.toml parameter_overrides
# or configured in AWS Systems Manager Parameter Store / Secrets Manager.
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# ==============================================================================

# --- Node & Application Core ---
NODE_ENV=production
LOG_LEVEL=info
PORT=4000
API_PREFIX=/api

# --- CORS Allowed Origins ---
# Comma-separated list of origins permitted to call the API Gateway
CORS_ORIGINS=https://kissan-mithar.vercel.app,https://kissan-mithar-app.vercel.app,http://localhost:5173

# --- PostgreSQL Database (Supabase) ---
# DATABASE_URL: Pooler connection string with PgBouncer enabled (port 6543)
# Essential for serverless Lambda execution to prevent connection exhaustion.
DATABASE_URL=postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# DIRECT_URL: Direct database connection (port 5432) for running schema migrations
DIRECT_URL=postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- Authentication & JWT ---
# Strong 32+ character random secret for signing JWTs
JWT_SECRET=replace_with_a_secure_random_64_character_hex_or_base64_string
JWT_EXPIRES_IN=7d

# --- Firebase Admin SDK (Authentication & FCM Notifications) ---
# Set MOCK_FIREBASE_AUTH=true if deploying without Firebase credentials
MOCK_FIREBASE_AUTH=false
FIREBASE_PROJECT_ID=kissan-mithar
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@kissan-mithar.iam.gserviceaccount.com
# Format private key on a single line with literal \n escapes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# --- Cloudinary (Media Uploads & Farmer Audio Notes) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=kissan_mithar_uploads

# --- Agricultural Weather Advisory (OpenWeatherMap) ---
WEATHER_API_KEY=your_openweathermap_api_key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# --- SMS OTP Delivery (Fast2SMS) ---
SMS_PROVIDER=fast2sms
SMS_API_KEY=your_fast2sms_api_key
