# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api

# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kissan_mithar?schema=public"

# JWT Authentication Secrets
JWT_SECRET="kissan_mithar_jwt_super_secret_key_2026_dev"
JWT_EXPIRES_IN="30d"

# Firebase Admin SDK Configuration
# For production: set FIREBASE_SERVICE_ACCOUNT_JSON or individual vars
FIREBASE_PROJECT_ID="kissan-mithar-app"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@kissan-mithar-app.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY=""

# Cloudinary Configuration for Direct & Signed Uploads
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_UPLOAD_PRESET="kissan_mithar_uploads"

# Weather Provider API (OpenWeather / WeatherAPI)
WEATHER_API_KEY="your-weather-api-key"
WEATHER_API_URL="https://api.openweathermap.org/data/2.5"

# Development / Mock Modes
MOCK_FIREBASE_AUTH=true
MOCK_WEATHER_FALLBACK=true

# WhatsApp Business Cloud API (Meta)
# Get these from: https://developers.facebook.com → WhatsApp → API Setup
# If not set, WhatsApp messages will be logged to the console (mock mode)
