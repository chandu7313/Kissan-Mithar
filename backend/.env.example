# Server Configuration
PORT=4000
NODE_ENV=production
API_PREFIX=/api
# CORS: comma-separated allowed origins for production
CORS_ORIGINS=https://admin.kissanmithar.in,https://kissanmithar.in

# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://user:password@host:5432/dbname?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# JWT Authentication Secrets (MUST be 64+ chars random string in production)
JWT_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_64_CHAR_SECRET"
JWT_EXPIRES_IN="30d"

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_UPLOAD_PRESET="kissan_mithar_uploads"

# Weather Provider API (OpenWeatherMap)
WEATHER_API_KEY="your-openweathermap-api-key"
WEATHER_API_URL="https://api.openweathermap.org/data/2.5"

# SMS Provider (Fast2SMS)
SMS_PROVIDER="FAST2SMS"
SMS_API_KEY="your-fast2sms-api-key"

# Development / Mock Modes (MUST be false in production)
MOCK_FIREBASE_AUTH=false
MOCK_WEATHER_FALLBACK=false

# Supabase Auth Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
