datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum ProductCategory {
  SEEDS
  FERTILIZERS
  ORGANIC_INPUTS
  CROP_PROTECTION_BIO
  CROP_PROTECTION_CHEMICAL
  FARM_MACHINERY_TOOLS
  IRRIGATION_EQUIPMENT
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PROCESSING
  DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  UPI
  RAZORPAY
  CREDIT_KISAN
}

enum AgriBazaarRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  SOURCING_IN_PROGRESS
  SUPPLIER_IDENTIFIED
  VERIFICATION_IN_PROGRESS
  PROCUREMENT_IN_PROGRESS
  DELIVERY_IN_PROGRESS
  DELIVERED
  CANCELLED
}

enum AgriBazaarListingStatus {
  ACTIVE
  IN_NEGOTIATION
  PROCURED
  INACTIVE
}

/// Scoped read-only projection until Stage 5 Identity REST API
model Farmer {
  id          String  @id @default(uuid())
  phoneNumber String  @unique
  name        String
  village     String?
  district    String?
  state       String?

  agriProductListings AgriProductListing[]
  agriProductRequests AgriProductRequest[]
  cart                Cart?
  orders              Order[]

  @@map("farmers")
}

model MandiPrice {
  id         String   @id @default(uuid())
  commodity  String
  variety    String?
  market     String
  district   String
  state      String
  minPrice   Float
  maxPrice   Float
  modalPrice Float
  priceDate  DateTime @default(now())
  trend      String   @default("STABLE")
  createdAt  DateTime @default(now())

  @@index([commodity])
  @@index([market])
  @@index([state])
  @@map("mandi_prices")
}

model ProductCatalog {
  id                String          @id @default(uuid())
  sku               String          @unique
  name              String
  brand             String
  category          ProductCategory
  technicalName     String?
  npkRatio          String?
  applicableCrops   String[]
  dosageGuide       String?
  packagingSize     String
  unit              String
  price             Float
  mrp               Float
  discountPercent   Float?          @default(0.0)
  stockQuantity     Int             @default(100)
  inStock           Boolean         @default(true)
  imageUrls         String[]
  description       String          @db.Text
  usageInstructions String?         @db.Text
  isOrganic         Boolean         @default(false)
  rating            Float           @default(4.7)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([category])
  @@index([inStock])
  @@index([name])
  @@index([technicalName])
  @@map("product_catalog")
}

model Cart {
  id        String     @id @default(uuid())
  farmerId  String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  farmer Farmer     @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  items  CartItem[]

  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  productId String
  quantity  Int            @default(1)
  unitPrice Float
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product ProductCatalog @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id              String               @id @default(uuid())
  orderNumber     String               @unique
  farmerId        String
  totalAmount     Float
  discountAmount  Float                @default(0.0)
  deliveryFee     Float                @default(0.0)
  finalAmount     Float
  orderStatus     OrderStatus          @default(PLACED)
  paymentStatus   PaymentStatus        @default(PENDING)
  paymentMethod   PaymentMethod        @default(CASH_ON_DELIVERY)
  shippingAddress Json
  notes           String?
  placedAt        DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  farmer   Farmer               @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  payments PaymentTransaction[]

  @@index([farmerId])
  @@index([orderStatus])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id          String         @id @default(uuid())
  orderId     String
  productId   String
  productName String
  packaging   String
  quantity    Int
  unitPrice   Float
  totalPrice  Float

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product ProductCatalog @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

model PaymentTransaction {
  id             String        @id @default(uuid())
  orderId        String
  transactionRef String?       @unique
  amount         Float
  gateway        PaymentMethod
  status         PaymentStatus @default(PENDING)
  rawResponse    Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("payment_transactions")
}

model AgriProductListing {
  id           String                  @id @default(uuid())
  sellerId     String
  productName  String?
  variety      String?
  minQuantity  Float?
  maxQuantity  Float?
  quantityUnit String?
  price        Float?
  priceUnit    String?
  locationType String                  @default("MANUAL")
  locationName String?
  village      String?
  mandal       String?
  district     String?
  state        String?
  pincode      String?
  latitude     Float?
  longitude    Float?
  photos       Json?
  status       AgriBazaarListingStatus @default(ACTIVE)
  notes        String?
  adminNotes   String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  seller  Farmer                    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  matches AgriProductRequestMatch[]

  @@index([sellerId])
  @@index([status])
  @@index([productName])
  @@map("agri_product_listings")
}

model AgriProductRequest {
  id               String                      @id @default(uuid())
  buyerId          String
  productName      String
  variety          String?
  requiredQuantity Float
  quantityUnit     String
  expectedPrice    Float?
  priceUnit        String?
  locationType     String                      @default("MANUAL")
  locationName     String?
  village          String?
  mandal           String?
  district         String?
  state            String?
  pincode          String?
  latitude         Float?
  longitude        Float?
  photos           Json?
  status           AgriBazaarRequestStatus     @default(SUBMITTED)
  adminNotes       String?
  verifiedQuantity Float?
  verifiedQuality  String?
  procurementCost  Float?
  finalQuotePrice  Float?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  buyer   Farmer                      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  matches AgriProductRequestMatch[]
  history AgriProductRequestHistory[]

  @@index([buyerId])
  @@index([status])
  @@index([productName])
  @@map("agri_product_requests")
}

model AgriProductRequestMatch {
  id            String             @id @default(uuid())
  requestId     String
  listingId     String
  matchedBy     String?
  status        String             @default("POTENTIAL")
  internalNotes String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  request AgriProductRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  listing AgriProductListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([listingId])
  @@map("agri_product_request_matches")
}

model AgriProductRequestHistory {
  id             String                   @id @default(uuid())
  requestId      String
  previousStatus AgriBazaarRequestStatus?
  newStatus      AgriBazaarRequestStatus
  changedBy      String?
  internalNotes  String?
  createdAt      DateTime                 @default(now())

  request AgriProductRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([createdAt])
  @@map("agri_product_request_history")
}
