[Unit]
Description=Kissan Mithar Production Backend Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Kissan-Mithar/backend
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=5
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=kissan-mithar-backend
Environment=NODE_ENV=production
Environment=PORT=4000

[Install]
WantedBy=multi-user.target

