# ==============================================================================
# KISSAN MITHAR - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. Supabase Database & Auth (https://supabase.com)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_DB_URL=postgresql://postgres.your-project-id:your-password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. SMS / OTP Provider (Fast2SMS / MSG91 / 2Factor / Twilio)
SMS_PROVIDER=FAST2SMS
SMS_API_KEY=your-sms-api-key-here
SMS_SENDER_ID=KISSAN_MITHAR

# 3. Location / GPS
USE_NATIVE_GPS=true

# 4. Live Weather API (OpenWeatherMap / WeatherAPI)
WEATHER_API_KEY=your-weather-api-key-here

# 5. Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=kissan_mithar_uploads

# 6. Backend REST API Base URL
API_BASE_URL=https://api.kissanmithar.in/v1
